SMARTLOCKER_BACKEND_URL=http://192.168.1.10:8080
SMARTLOCKER_STATION_ID=00000000-0000-0000-0000-000000000000
SMARTLOCKER_DEVICE_ID=00000000-0000-0000-0000-000000000000
SMARTLOCKER_DEVICE_TOKEN=replace-with-device-token

# auto chooses Picamera2 when installed, then falls back to OpenCV.
SMARTLOCKER_CAMERA_BACKEND=auto
SMARTLOCKER_CAMERA_INDEX=0
SMARTLOCKER_CAMERA_WIDTH=1280
SMARTLOCKER_CAMERA_HEIGHT=720
SMARTLOCKER_CAMERA_FPS=15
SMARTLOCKER_REQUEST_TIMEOUT=10

# InsightFace reads only this local directory; no model is downloaded at runtime.
# Expected layout: /opt/smartlocker/insightface/models/buffalo_l/*.onnx
SMARTLOCKER_FACE_MODEL_ROOT=/opt/smartlocker/insightface
SMARTLOCKER_FACE_MODEL_NAME=buffalo_l
